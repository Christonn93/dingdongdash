{
  "expo": {
    "name": "dingdongdash",
    "slug": "dingdongdash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dingdongdash",
    "userInterfaceStyle": "automatic",
    "author": "Christopher Tønnesland",
    "extra": {
      "fingerprint": "fba6e6e0-8d90-4049-a45b-7db4364eec89"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dingdongdash"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0822",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dingdongdash"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0822",
          "dark": {
            "backgroundColor": "#0a0620"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#f97316",
          "defaultChannel": "rings"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
