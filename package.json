{
  "name": "dingdongdash",
  "private": true,
  "license": "MIT",
  "author": "Christopher Tønnesland <christopher.tonnesland@email.com>",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.7.5",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tanstack/react-query": "^5.102.8",
      "@tanstack/react-form": "^1.33.5",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "@better-auth/expo": "1.7.5",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "build": "turbo run build --filter='!desktop' && turbo run build -F desktop",
    "build:desktop": "turbo run build:stable -F desktop --",
    "build:desktop:canary": "turbo run build:canary -F desktop --",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @dingdongdash/db --",
    "deploy": "turbo run deploy -F @dingdongdash/infra --",
    "destroy": "turbo run destroy -F @dingdongdash/infra --",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev:hmr -F desktop --",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev:bare -F hono --",
    "dev:web": "turbo run dev:bare -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/"
  },
  "dependencies": {
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-db": "^0.4.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@cloudflare/workers-types": "catalog:",
    "@dingdongdash/config": "workspace:*",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.9"
}
